<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Kristen’s Glam Hub</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #ffe4ef, #ffd6e8);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Roboto', sans-serif;
      padding: 18px;
    }

    .box {
      width: 360px;
      background: #ffffff;
      padding: 35px;
      border-radius: 14px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.15);
      text-align: center;
    }

    h1 {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      font-size: 42px;
      margin-bottom: 10px;
      -webkit-text-stroke: 1px #d63384;
      color: transparent;
    }

    input {
      width: 90%;
      margin: 10px 0;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 15px;
    }

    .password-field {
      width: 90%;
      margin: 10px auto;
      position: relative;
    }

    .password-field input {
      width: 100%;
      padding-right: 50px;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 16px;
      color: #555;
      padding: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      outline: none;
      -webkit-appearance: none;
      appearance: none;
    }

    .toggle-password:focus,
    .toggle-password:active {
      background: transparent;
      outline: none;
    }

    button {
      width: 100%;
      padding: 12px;
      background: #d63384;
      color: white;
      border: none;
      font-size: 17px;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background: #b1256b;
    }

    .hidden { display: none; }

    .msg {
      margin-top: 10px;
      font-size: 14px;
      color: green;
    }

    .error {
      color: red;
      font-size: 14px;
      margin-top: 8px;
    }

    @media (max-width: 480px) {
      .box {
        width: 100%;
        padding: 24px 18px;
      }

      h1 {
        font-size: 34px;
      }

      input {
        width: 100%;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

<div class="box">
  <h1>Login</h1>

  <!-- STEP 1: EMAIL + PASSWORD -->
  <form id="loginForm">
    <input type="email" name="email" placeholder="Email" required />
    <div class="password-field">
      <input id="loginPassword" type="password" name="password" placeholder="Password" required />
      <button type="button" class="toggle-password" data-target="loginPassword" aria-label="Show password">👁️</button>
    </div>
    <p style="text-align:right; width:90%; margin:auto;">
  <a href="/forgot-password"
     style="font-size:14px; color:#d63384; text-decoration:none;">
     Forgot Password?
  </a>
</p>
    <button type="submit">Send OTP</button>
  </form>

  <!-- STEP 2: OTP -->
  <form id="otpForm" class="hidden">
    <input type="text" name="otp" placeholder="Enter OTP" required />
    <button type="submit">Verify OTP</button>
  </form>

  <div id="message" class="msg"></div>
  <div id="error" class="error"></div>

  <p style="margin-top: 20px; font-size: 14px; color: #555;">
    New here? <a href="/signup" style="color: #d63384; font-weight: bold; text-decoration: none;">Sign in</a>
  </p>

</div>

<script>
  const loginForm = document.getElementById("loginForm");
  const otpForm = document.getElementById("otpForm");
  const msg = document.getElementById("message");
  const error = document.getElementById("error");

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.innerText = "";

    const res = await fetch("/send-login-otp", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: loginForm.email.value,
        password: loginForm.password.value
      })
    });

    const data = await res.json();

    if (!data.success) {
      error.innerText = data.message;
      return;
    }

    loginForm.classList.add("hidden");
    otpForm.classList.remove("hidden");
    msg.innerText = "OTP sent to your email";
  });

  otpForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.innerText = "";

    const res = await fetch("/verify-login-otp", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ otp: otpForm.otp.value })
    });

    const data = await res.json();

    if (!data.success) {
      error.innerText = data.message;
      return;
    }

    msg.innerText = "Email Verification Successful";
    setTimeout(() => {
      window.location.href = "/";
    }, 1200);
  });
  const toggleButtons = document.querySelectorAll('.toggle-password');

  toggleButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const targetId = button.dataset.target;
      const input = document.getElementById(targetId);
      if (!input) return;

      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      button.textContent = isPassword ? '🙈' : '👁️';
      button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
    });
  });
</script>

<script src="/js/mobile-nav.js"></script>
</body>
</html>
