<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | Kristen’s Glam Hub</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(135deg, #ffe4ef, #ffd6e8);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Roboto', sans-serif;
      padding: 18px;
    }

    .box {
      width: 360px;
      background: #ffffff;
      padding: 35px;
      border-radius: 14px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.15);
      text-align: center;
    }

    h1 {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      font-size: 42px;
      margin-bottom: 10px;
      -webkit-text-stroke: 1px #d63384;
      color: transparent;
    }

    input {
      width: 90%;
      margin: 10px 0;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 15px;
    }

    button {
      width: 100%;
      padding: 12px;
      background: #d63384;
      color: white;
      border: none;
      font-size: 17px;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background: #b1256b;
    }

    .msg {
      margin-top: 10px;
      font-size: 14px;
      color: green;
    }

    .error {
      color: red;
      font-size: 14px;
      margin-top: 8px;
    }

    @media (max-width: 480px) {
      .box {
        width: 100%;
        padding: 24px 18px;
      }

      h1 {
        font-size: 34px;
      }

      input {
        width: 100%;
      }
    }
  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

<div class="box">

  <h1>Forgot Password</h1>

  <% if(error){ %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if(success){ %>
    <div class="msg"><%= success %></div>
  <% } %>

  <form method="POST" action="/forgot-password">

    <input
      type="email"
      name="email"
      placeholder="Enter your email"
      required
    />

    <button type="submit">
      Send Reset Link
    </button>

  </form>

</div>

<script src="/js/mobile-nav.js"></script>
</body>
</html>
