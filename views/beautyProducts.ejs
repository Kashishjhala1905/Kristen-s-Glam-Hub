<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Beauty Products | Kristen’s Glam Hub</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500&family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #fff8f5;
            font-family: 'Roboto', sans-serif;
        }

        /* 🌸 NAVBAR */
        nav {
            background-color: #ffffff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 40px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
            margin: 0;
            padding: 0;
        }

        nav ul li a, .login {
            text-decoration: none;
            color: #333;
            font-weight: 600;
            transition: color 0.3s ease;
        }

        nav ul li a:hover, .login:hover {
            color: #d63384;
        }

        .nav-icons { display: flex; gap: 20px; align-items: center; }
        .nav-icon-wrapper { position: relative; cursor: pointer; }
        .nav-icon-wrapper:hover .tooltip { opacity: 1; visibility: visible; }
        .tooltip {
            position: absolute;
            top: 110%;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            color: #fff;
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 11px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s;
            z-index: 100;
        }

        .nav-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #f3d1dc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: bold;
            color: #5a2a55;
            overflow: hidden;
            border: 1px solid #d63384;
        }
        .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }

        /* 🌸 HEADER */
        header {
            text-align: center;
            padding: 40px 20px;
            background: linear-gradient(to right, #f3d1dc, #ffe0f0);
        }

        header h1 {
            font-family: "Edu AU VIC WA NT Arrows", cursive;
            font-size: 48px;
            margin: 0;
            color: #5a2a55;
        }

        header h5 {
            color: #5a2a55;
            margin-top: 20px;
            letter-spacing: 2px;
            display: inline-block;
            border: 1px solid #5a2a55;
            padding: 8px 25px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            animation: slowFloat 3s ease-in-out infinite;
            background: rgba(255, 255, 255, 0.2);
        }

        @keyframes slowFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        /* CATEGORY */
        .category {
            margin: 50px auto;
            max-width: 1200px;
            padding: 0 20px;
        }

        .category h2 {
            color: #d63384;
            font-family: 'Playfair Display', serif;
            font-size: 2.3rem;
            text-align: center;
            margin-bottom: 20px;
            letter-spacing: 1px;
        }

        /* PRODUCT GRID */
        .product-list {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .product-card {
            background-color: white;
            width: 250px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.10);
            overflow: hidden;
            text-align: center;
            transition: all 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 8px 18px rgba(0,0,0,0.20);
        }

        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .product-info {
            padding: 15px;
        }

        .product-info h3 {
            font-size: 1.1rem;
            color: #333;
            margin-bottom: 8px;
        }

        .product-info p {
            font-size: 0.95rem;
            color: #777;
            margin-bottom: 10px;
        }

        .product-info button {
            background-color: #d63384;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.3s;
        }

        .product-info button:hover {
            background-color: #b1256b;
        }

        /* EXPLORE BUTTON */
        .explore-btn {
            display: block;
            margin: 25px auto;
            background-color: #ffd6e8;
            color: #d63384;
            border: 2px solid #d63384;
            border-radius: 8px;
            padding: 10px 25px;
            font-weight: 600;
            text-decoration: none;
            font-size: 1rem;
            width: fit-content;
            transition: 0.3s ease;
        }

        .explore-btn:hover {
            background-color: #d63384;
            color: #fff;
            transform: scale(1.06);
        }

        /* SEPARATOR */
        .separator {
            margin: 50px auto;
            width: 80%;
            height: 2px;
            background-color: #f3b7d1;
            opacity: 0.5;
        }

        /* TOAST POPUP */
        #toast {
            visibility: hidden;
            min-width: 260px;
            max-width: calc(100% - 40px);
            background-color: #d63384;
            color: #fff;
            text-align: center;
            border-radius: 10px;
            padding: 12px 16px;
            position: fixed;
            z-index: 1200;
            left: 50%;
            bottom: 28px;
            transform: translateX(-50%) translateY(10px);
            font-weight: 500;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            opacity: 0;
            transition: opacity 0.25s ease, transform 0.25s ease;
        }

        /* 🎭 Heading Reveal Animation */
        .reveal-text span {
            display: inline-block;
            opacity: 0;
            transform: translateY(10px);
            animation: revealLetter 0.05s forwards;
        }

        @keyframes revealLetter {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>

    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/booknow">Book Now</a></li>
            <li><a href="/services">Services</a></li>
            <li><a href="/beautyproducts">Beauty Products</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="nav-right" style="display: flex; gap: 20px; align-items: center;">
            <div class="nav-icons">
                <% if (locals.user) { %>
                <div class="nav-icon-wrapper" onclick="location.href='/wishlist'">
                    <i class="fas fa-heart" style="color:#d63384; font-size:1.2em;"></i>
                    <div class="tooltip">My Wishlist</div>
                </div>
                <div class="nav-icon-wrapper" onclick="location.href='/mycart'">
                    <i class="fas fa-shopping-cart" style="color:#333; font-size:1.2em;"></i>
                    <div class="tooltip">My Cart</div>
                </div>
                <div class="nav-icon-wrapper" onclick="location.href='/profile'">
                    <div class="nav-avatar">
                        <% if (user.photo) { %>
                            <img src="<%= user.photo %>" alt="Profile">
                        <% } else { %>
                            <%= user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                    <div class="tooltip">My Profile</div>
                </div>
                <% } else { %>
                    <a class="login" href="/login">Login</a> / 
                    <a class="login" href="/signup">Sign Up</a>
                <% } %>
            </div>
        </div>
    </nav>

    <header>
        <h1 class="reveal-text" id="beautyHeading">Our Beauty Essentials</h1>
        <h5>Find the perfect match for your beauty</h5>
    </header>

    <% const sections = ["skin", "hair", "nail", "makeup"]; %>

    <% sections.forEach(section => { %>
    <section class="category">
        <h2><%= section.charAt(0).toUpperCase() + section.slice(1) %> Care</h2>

        <div class="product-list">
            <% categories[section].forEach(product => { %>
            <div class="product-card">
                <img src="<%= product.image_url %>" alt="<%= product.product_name %>"
                     onerror="this.src='/images/placeholder.jpg'">
                <div class="product-info">
                    <h3><%= product.product_name %></h3>
                    <p><%= product.price %></p>
                    <button onclick="addToCart('<%= product.product_name %>','<%= product.price %>','<%= product.image_url %>')">
                        Add to Cart
                    </button>
                </div>
            </div>
            <% }) %>
        </div>

        <a href="/explore/<%= section %>" class="explore-btn">Explore More</a>
    </section>

    <div class="separator"></div>
    <% }) %>

    <div id="toast">Added to cart!</div>

<script>
    function showToast(message) {
        const t = document.getElementById("toast");
        t.textContent = message;
        t.style.visibility = "visible";
        t.style.opacity = "1";
        t.style.transform = "translateX(-50%) translateY(0)";

        setTimeout(() => {
            t.style.opacity = "0";
            t.style.transform = "translateX(-50%) translateY(10px)";
            setTimeout(() => t.style.visibility = "hidden", 300);
        }, 2000);
    }

    function addToCart(name, price, image) {
        fetch("/cart/add", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name, price, image })
        })
        .then(res => res.json())
        .then(() => showToast(`"${name}" added to cart 💖`));
    }

    document.addEventListener("DOMContentLoaded", () => {
      const heading = document.getElementById("beautyHeading");
      if (heading) {
        const text = heading.textContent;
        heading.innerHTML = "";
        [...text].forEach((char, i) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.style.animationDelay = `${i * 0.03}s`;
          heading.appendChild(span);
        });
      }
    });
</script>
</body>
</html>
