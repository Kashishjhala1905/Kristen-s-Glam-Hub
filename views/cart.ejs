<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Cart | Kristen’s Glam Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Playfair+Display&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    body { margin: 0; background: #fff8f5; font-family: 'Roboto', sans-serif; }
    nav {
      background: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    nav ul { list-style: none; display: flex; gap: 18px; padding: 0; margin: 0; }
    nav ul li a { text-decoration: none; color: #333; font-weight: 600; }
    nav ul li a:hover, .login:hover { color: #d63384; }
    .nav-icons { display: flex; gap: 20px; align-items: center; }
    .nav-icon-wrapper { position: relative; cursor: pointer; }
    .nav-icon-wrapper:hover .tooltip { opacity: 1; visibility: visible; }
    .tooltip {
        position: absolute;
        top: 110%;
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: #fff;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 11px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s;
        z-index: 100;
    }
    .nav-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #f3d1dc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: bold;
        color: #5a2a55;
        overflow: hidden;
        border: 1px solid #d63384;
    }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
    h1 {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      background: linear-gradient(to right, #f3d1dc, #ffe0f0);
      text-align: center;
      padding: 30px 20px;
      margin: 0;
      font-size: 38px;
      color: #5a2a55;
    }
    .container {
      max-width: 1200px;
      margin: 40px auto;
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 30px;
      padding: 0 20px;
    }
    .cart-item {
      background: white;
      display: flex;
      gap: 18px;
      padding: 16px;
      border-radius: 12px;
      margin-bottom: 18px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
      align-items: center;
    }
    .cart-item img {
      width: 110px;
      height: 140px;
      object-fit: cover;
      border-radius: 8px;
    }
    .item-info { flex: 1; }
