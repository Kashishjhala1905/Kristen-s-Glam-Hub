<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up | Kristen’s Glam Hub</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #ffd6e8, #ffe4ef);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Roboto', sans-serif;
            padding: 18px;
        }

        .box {
            width: 360px;
            background: #ffffff;
            padding: 40px;
            border-radius: 14px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
            text-align: center;
        }

        h1 {
            font-family: "Edu AU VIC WA NT Arrows", cursive;
            font-size: 45px;
            margin-bottom: 10px;
            color: transparent;
            -webkit-text-stroke: 1px #d63384;
        }

        .error {
            color: red;
            margin-bottom: 12px;
            font-size: 14px;
        }

        input {
            width: 90%;
            margin: 10px 0;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 15px;
        }

        .password-field {
            width: 90%;
            margin: 10px auto;
            position: relative;
        }

        .password-field input {
            width: 100%;
            padding-right: 50px;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 16px;
            color: #555;
            padding: 0;
            width: 28px;
            height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            outline: none;
            -webkit-appearance: none;
            appearance: none;
        }

        .toggle-password:focus,
        .toggle-password:active {
            background: transparent;
            outline: none;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #d63384;
            color: white;
            border: none;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
            transition: .3s;
        }

        button:hover {
            background: #b1256b;
        }

        a {
            text-decoration: none;
            color: #d63384;
            font-weight: bold;
        }

        @media (max-width: 480px) {
            .box {
                width: 100%;
                padding: 24px 18px;
            }

            h1 {
                font-size: 34px;
            }

            input {
                width: 100%;
            }
        }
    </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

<div class="box">
    <h1>Sign Up</h1>

    <% if (error) { %>
        <div class="error"><%= error %></div>
    <% } %>

    <!-- 🔐 SEND OTP FIRST -->
    <form action="/signup/send-otp" method="POST">
        <input type="text" name="name" placeholder="Full Name" required>
        <input type="email" name="email" placeholder="Email Address" required>
        <input type="text" name="contact" placeholder="Contact Number" required>
        <div class="password-field">
          <input id="signupPassword" type="password" name="password" placeholder="Password" required>
          <button type="button" class="toggle-password" data-target="signupPassword" aria-label="Show password">👁️</button>
        </div>

        <button type="submit">Send OTP</button>
    </form>

    <script>
      const toggleButtons = document.querySelectorAll('.toggle-password');
      toggleButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.dataset.target;
          const input = document.getElementById(targetId);
          if (!input) return;

          const isPassword = input.type === 'password';
          input.type = isPassword ? 'text' : 'password';
          button.textContent = isPassword ? '🙈' : '👁️';
          button.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
        });
      });
    </script>

    <p style="margin-top:15px;">
        Already have an account?
        <a href="/login">Login here</a>
    </p>
</div>

<script src="/js/mobile-nav.js"></script>
</body>
</html>
