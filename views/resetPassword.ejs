<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset Password | Kristen’s Glam Hub</title>

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      height: 100vh;
      background: linear-gradient(135deg, #ffe4ef, #ffd6e8);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Roboto', sans-serif;
    }

    .box {
      width: 360px;
      background: #ffffff;
      padding: 35px;
      border-radius: 14px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.15);
      text-align: center;
    }

    h1 {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      font-size: 42px;
      margin-bottom: 10px;
      -webkit-text-stroke: 1px #d63384;
      color: transparent;
    }

    input {
      width: 90%;
      margin: 10px 0;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 15px;
    }

    button {
      width: 100%;
      padding: 12px;
      background: #d63384;
      color: white;
      border: none;
      font-size: 17px;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background: #b1256b;
    }

    .error {
      color: red;
      font-size: 14px;
      margin-top: 8px;
    }
  </style>
</head>

<body>

<div class="box">

  <h1>Reset Password</h1>

  <% if(error){ %>
    <div class="error"><%= error %></div>
  <% } %>

  <form method="POST">

    <input
      type="password"
      name="password"
      placeholder="Enter new password"
      required
    />

    <button type="submit">
      Update Password
    </button>

  </form>

</div>

</body>
</html>