<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Pay Now | Kristen’s Glam Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background-color: #fff8f5;
    }

/* 🌸 Navbar */
nav {
  background-color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 40px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 25px;
  margin: 0;
  padding: 0;
}

nav ul li a,
.login {
  text-decoration: none;
  color: #333;
  font-weight: 600;
  transition: color 0.3s ease;
}

nav ul li a:hover,
.login:hover {
  color: #d63384;
}

.nav-icons {
  display: flex;
  gap: 20px;
  align-items: center;
}

.nav-icon-wrapper {
  position: relative;
  cursor: pointer;
}

.nav-icon-wrapper:hover .tooltip {
  opacity: 1;
  visibility: visible;
}

.tooltip {
  position: absolute;
  top: 110%;
  left: 50%;
  transform: translateX(-50%);
  background: #333;
  color: #fff;
  padding: 5px 10px;
  border-radius: 4px;
  font-size: 11px;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transition: 0.3s;
  z-index: 100;
}

.nav-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f3d1dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  color: #5a2a55;
  overflow: hidden;
  border: 1px solid #d63384;
}

.nav-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

    h1 {
      text-align: center;
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      background: linear-gradient(to right, #f3d1dc, #ffe0f0);
      padding: 40px 20px;
      margin: 0;
      font-size: 48px;
      color: #5a2a55;
    }

    .container {
      max-width: 700px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
      text-align: center;
    }

    h3 {
      color: #d63384;
      margin-bottom: 16px;
    }

    button {
      background: #d63384;
      color: #fff;
      border: none;
      padding: 12px 22px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 16px;
      margin-top: 20px;
    }

    button:hover {
      background-color: #e36fa9;
    }

    .success {
      color: green;
      font-weight: bold;
      font-size: 18px;
    }

    .qr-container {
      margin: 30px auto;
      padding: 20px;
      border: 2px solid #f3d1dc;
      border-radius: 15px;
      background: #fff;
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      max-width: 400px;
    }

    .qr-title {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      color: #5a2a55;
      font-size: 28px;
      margin-bottom: 15px;
    }

    .qr {
      width: 320px;
      height: auto;
      margin: 0 auto;
      border-radius: 8px;
    }

    .muted {
      color: #777;
      font-size: 14px;
      margin-top: 15px;
    }

  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

  <!-- 🌸 Navbar -->
  <nav>
    <div class="nav-logo" onclick="location.href='/'" style="cursor:pointer; display:flex; align-items:center; margin-right: 15px;">
      <img src="/images/logo.png" alt="Glam Hub Logo" style="height: 45px; width: auto; border-radius: 50%; border: 2px solid #d63384; padding: 2px;" />
    </div>

    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/booknow">Book Now</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/beautyproducts">Beauty Products</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>

    <div class="nav-right" style="display: flex; gap: 20px; align-items: center;">
      <% if (locals.user) { %>
        <div class="nav-icons">
          <div class="nav-icon-wrapper" onclick="location.href='/wishlist'">
            <i class="fas fa-heart" style="color:#d63384; font-size:1.2em;"></i>
            <div class="tooltip">My Wishlist</div>
          </div>
          <div class="nav-icon-wrapper" onclick="location.href='/mycart'">
            <i class="fas fa-shopping-cart" style="color:#333; font-size:1.2em;"></i>
            <div class="tooltip">My Cart</div>
          </div>
          <div class="nav-icon-wrapper" onclick="location.href='/profile'">
            <div class="nav-avatar">
              <% if (user.photo) { %>
                <img src="<%= user.photo %>" alt="Profile">
              <% } else { %>
                <%= user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <div class="tooltip">My Profile</div>
          </div>
        </div>
      <% } else { %>
        <a class="login" href="/login">Login</a> /
        <a class="login" href="/signup">Sign Up</a>
      <% } %>
    </div>
  </nav>

  <h1>Payment</h1>

  <div class="container">

    <% if (paymentMode === "COD") { %>

      <h3>Cash on Delivery</h3>
      <p class="success">🎉 Your order has been placed successfully!</p>
      <a href="/"><button>Go to Home</button></a>

    <% } else if (paymentMode === "UPI") { %>

      <div class="qr-container">
        <h2 class="qr-title">Kristen's Glam Hub</h2>
        <h3 style="margin-bottom: 20px;">Scan QR Code to Pay</h3>
        
        <img src="/images/myQR.jpeg" alt="UPI QR Code" class="qr">
        
        <p style="font-size: 1.4em; font-weight: bold; color: #d63384; margin: 20px 0;">Total Amount: ₹<%= total %></p>
        <p class="muted">Scan this QR code using GPay, PhonePe, or Paytm to complete your transaction.</p>
      </div>

      <form action="/place-order/confirm" method="POST">
        <button type="submit">Verify & Place Order</button>
      </form>

    <% } else if (paymentMode === "CARD") { %>

      <h3>Complete Your Payment</h3>
      <p>Total Amount: ₹<%= total %></p>

      <button id="payBtn">Pay Now</button>

    <% } %>

  </div>

<script>

const btn = document.getElementById("payBtn");

if (btn) {

  btn.onclick = async function () {

    const res = await fetch("/create-order", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        amount: <%= total %>
      })
    });

    const data = await res.json();

    const options = {
      key: "YOUR_KEY_ID",
      amount: data.amount,
      currency: "INR",
      name: "Kristen’s Glam Hub",
      description: "Beauty Products Payment",
      order_id: data.id,

      handler: async function (response) {

        await fetch("/verify-payment", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            amount: <%= total %>,
            mode: "<%= paymentMode %>"
          })
        });

        window.location.href = "/";
      },

      theme: {
        color: "#d63384"
      }
    };

    const rzp = new Razorpay(options);
    rzp.open();
  }
}

</script>

<script src="/js/mobile-nav.js"></script>
</body>
</html>