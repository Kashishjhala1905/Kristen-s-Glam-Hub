<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Wishlist - Kristen's Glam Hub</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Playfair+Display&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    body { background-color: #fff8f5; font-family: "Roboto", sans-serif; margin: 0; padding: 0; }
    nav { background: #fff; display: flex; justify-content: space-between; align-items: center; padding: 12px 24px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); }
    nav ul { list-style: none; display: flex; gap: 18px; padding: 0; margin: 0; }
    nav ul li a { text-decoration: none; color: #333; font-weight: 600; }
    .nav-icons { display: flex; gap: 20px; align-items: center; }
    .nav-icon-wrapper { position: relative; cursor: pointer; }
    .nav-icon-wrapper:hover .tooltip { opacity: 1; visibility: visible; }
    .tooltip {
      position: absolute;
      top: 110%;
      left: 50%;
      transform: translateX(-50%);
      background: #333;
      color: #fff;
      padding: 5px 10px;
      border-radius: 4px;
      font-size: 11px;
      white-space: nowrap;
      opacity: 0;
      visibility: hidden;
      transition: 0.3s;
      z-index: 100;
    }
    .nav-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #f3d1dc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: bold;
        color: #5a2a55;
        overflow: hidden;
        border: 1px solid #d63384;
    }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }

    h1 { text-align: center; font-family: "Edu AU VIC WA NT Arrows", cursive; background: linear-gradient(to right, #f3d1dc, #ffe0f0); padding: 30px 20px; color: #5a2a55; font-size: 38px; margin: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 24px; padding: 36px; max-width: 1200px; margin: 0 auto; }
    .product { background: #fff; border-radius: 12px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08); text-align: center; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
    .product img { width: 100%; height: 200px; object-fit: cover; border-radius: 8px; }
    .price { font-weight: 600; color: #d63384; }
    .remove-btn { background: #fff; color: #dc3545; border: 1px solid #dc3545; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 14px; text-decoration: none; transition: 0.3s; }
    .remove-btn:hover { background: #dc3545; color: #fff; }
    .empty-state { text-align: center; padding: 50px; color: #666; font-size: 18px; }
  </style>
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/booknow">Book Now</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/beautyproducts">Beauty Products</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <div class="nav-icons">
      <% if (locals.user) { %>
      <div class="nav-icon-wrapper" onclick="location.href='/wishlist'">
        <i class="fas fa-heart" style="color:#d63384; font-size:1.2em;"></i>
        <div class="tooltip">My Wishlist</div>
      </div>
      <div class="nav-icon-wrapper" onclick="location.href='/mycart'">
        <i class="fas fa-shopping-cart" style="color:#333; font-size:1.2em;"></i>
        <div class="tooltip">My Cart</div>
      </div>
      <div class="nav-icon-wrapper" onclick="location.href='/profile'">
        <div class="nav-avatar">
          <% if (user.photo) { %>
            <img src="<%= user.photo %>" alt="Profile">
          <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <div class="tooltip">My Profile</div>
      </div>
      <% } else { %>
          <a class="login" href="/login">Login</a> / 
          <a class="login" href="/signup">Sign Up</a>
      <% } %>
    </div>
  </nav>

  <h1>My Wishlist</h1>

  <div class="grid">
    <% if (wishlist && wishlist.length > 0) { %>
      <% wishlist.forEach(function(p){ %>
        <div class="product">
          <img src="<%= p.image %>" alt="<%= p.name %>" onerror="this.src='/images/placeholder.jpg'" />
          <h3><%= p.name %></h3>
          <div class="price">₹ <%= p.price.toFixed(2) %></div>
          <form action="/wishlist/remove/<%= p._id %>" method="POST">
            <button type="submit" class="remove-btn">Remove</button>
          </form>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <p>Your wishlist is empty. ❤️</p>
        <a href="/beautyproducts" style="color:#d63384; text-decoration:none; font-weight:bold;">Browse Products</a>
      </div>
    <% } %>
  </div>
</body>
</html>
