<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Place Order | Kristen’s Glam Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background-color: #fff8f5;
    }

    /* 🌸 Navbar */
nav {
  background-color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 40px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 25px;
  margin: 0;
  padding: 0;
}

nav ul li a,
.login {
  text-decoration: none;
  color: #333;
  font-weight: 600;
  transition: color 0.3s ease;
}

nav ul li a:hover,
.login:hover {
  color: #d63384;
}

.nav-icons {
  display: flex;
  gap: 20px;
  align-items: center;
}

.nav-icon-wrapper {
  position: relative;
  cursor: pointer;
}

.nav-icon-wrapper:hover .tooltip {
  opacity: 1;
  visibility: visible;
}

.tooltip {
  position: absolute;
  top: 110%;
  left: 50%;
  transform: translateX(-50%);
  background: #333;
  color: #fff;
  padding: 5px 10px;
  border-radius: 4px;
  font-size: 11px;
  white-space: nowrap;
  opacity: 0;
  visibility: hidden;
  transition: 0.3s;
  z-index: 100;
}

.nav-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #f3d1dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
  color: #5a2a55;
  overflow: hidden;
  border: 1px solid #d63384;
}

.nav-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

    .container {
      max-width: 900px;
      margin: 30px auto;
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    h1 {
  text-align: center;
  font-family: "Edu AU VIC WA NT Arrows", cursive;
  background: linear-gradient(to right, #f3d1dc, #ffe0f0);
  padding: 40px 20px;
  margin: 0;
  font-size: 48px;
  color: #5a2a55;
}

    h3 {
      color: #d63384;
      margin-bottom: 10px;
    }

    input {
      width: 100%;
      padding: 10px;
      margin: 8px 0 14px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 14px;
    }

    button {
      background: #d63384;
      color: #fff;
      border: none;
      padding: 10px 18px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 15px;
    }

    button:hover {
      background-color: #e36fa9;
    }

    .item {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #eee;
    }

    .total {
      font-size: 18px;
      font-weight: bold;
      margin-top: 12px;
      text-align: right;
    }

    .muted {
      color: #888;
      font-size: 14px;
    }

    hr {
      margin: 26px 0;
      border: none;
      border-top: 1px solid #eee;
    }
  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>
 <!-- 🌸 Navbar -->
<nav>
  <div class="nav-logo" onclick="location.href='/'"
    style="cursor:pointer; display:flex; align-items:center; margin-right: 15px;">
    
    <img src="/images/logo.png"
      alt="Glam Hub Logo"
      style="height: 45px; width: auto; border-radius: 50%; border: 2px solid #d63384; padding: 2px;" />
  </div>

  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/booknow">Book Now</a></li>
    <li><a href="/services">Services</a></li>
    <li><a href="/beautyproducts">Beauty Products</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>

  <div class="nav-right" style="display: flex; gap: 20px; align-items: center;">

    <% if (locals.user) { %>

      <div class="nav-icons">

        <div class="nav-icon-wrapper" onclick="location.href='/wishlist'">
          <i class="fas fa-heart" style="color:#d63384; font-size:1.2em;"></i>
          <div class="tooltip">My Wishlist</div>
        </div>

        <div class="nav-icon-wrapper" onclick="location.href='/mycart'">
          <i class="fas fa-shopping-cart" style="color:#333; font-size:1.2em;"></i>
          <div class="tooltip">My Cart</div>
        </div>

        <div class="nav-icon-wrapper" onclick="location.href='/profile'">

          <div class="nav-avatar">
            <% if (user.photo) { %>
              <img src="<%= user.photo %>" alt="Profile">
            <% } else { %>
              <%= user.name ? user.name.charAt(0).toUpperCase() : user.email.charAt(0).toUpperCase() %>
            <% } %>
          </div>

          <div class="tooltip">My Profile</div>
        </div>

      </div>

    <% } else { %>

      <a class="login" href="/login">Login</a> /
      <a class="login" href="/signup">Sign Up</a>

    <% } %>

  </div>
</nav>

  <h1>Place Order</h1>

  <div class="container">

    <!-- ADDRESS SECTION -->
    <h3>Delivery Address</h3>

    <% if (!address) { %>
      <form method="POST" action="/order/address">
        <input type="text" name="street" placeholder="House no, Building, Street, Area" required>
        <input type="text" name="city" placeholder="City" required>
        <input type="text" name="state" placeholder="State" required>
        <input type="text" name="pincode" placeholder="Pincode" required>
        <button type="submit">Save Address</button>
      </form>
    <% } else { %>
      <p><strong><%= address.street %></strong></p>
      <p><%= address.city %>, <%= address.state %> - <%= address.pincode %></p>
    <% } %>

    <hr>

    <!-- PAYMENT MODE -->
    <% if (address && !paymentMode) { %>
      <h3>Select Payment Mode</h3>

      <form method="POST" action="/order/payment-mode">
        <label>
          <input type="radio" name="paymentMode" value="COD" required>
          Cash on Delivery
        </label><br>

        <label>
          <input type="radio" name="paymentMode" value="UPI">
          UPI
        </label><br>

        <label>
          <input type="radio" name="paymentMode" value="CARD">
          Credit / Debit Card
        </label><br><br>

        <button type="submit">Save Payment Mode</button>
      </form>
    <% } %>

    <% if (paymentMode) { %>
      <h3>Payment Mode</h3>
      <p><strong><%= paymentMode %></strong></p>
    <% } %>

    <hr>

    <!-- ORDER SUMMARY -->
    <h3>Order Summary</h3>

    <% cart.forEach(item => { %>
      <div class="item">
        <span><%= item.name %> × <%= item.qty || 1 %></span>
        <span>₹<%= item.price * (item.qty || 1) %></span>
      </div>
    <% }) %>

    <div class="total">Total: ₹<%= total %></div>

    <hr>

    <!-- FINAL BUTTON -->
    <% if (address && paymentMode) { %>
      <form method="GET" action="/payment">
        <button>Proceed to Payment</button>
      </form>
    <% } else { %>
      <p class="muted">Please add address and select payment mode to continue</p>
    <% } %>

  </div>

<script src="/js/mobile-nav.js"></script>
</body>
</html>
