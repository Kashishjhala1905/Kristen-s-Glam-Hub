<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Our Services | Kristen's Glam Hub</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/logo.png">

<link rel="apple-touch-icon" href="/images/logo.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&family=Playfair+Display&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Edu+AU+VIC+WA+NT+Arrows:wght@400..700&display=swap" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background-color: #fff8f5;
    }

    /* 🌸 Navbar */
    nav {
      background-color: #ffffff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 40px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 25px;
      margin: 0;
      padding: 0;
    }

    nav ul li a, .login {
      text-decoration: none;
      color: #333;
      font-weight: 600;
      transition: color 0.3s ease;
    }

    nav ul li a:hover, .login:hover {
      color: #d63384;
    }

    .nav-icons { display: flex; gap: 20px; align-items: center; }
    .nav-icon-wrapper { position: relative; cursor: pointer; }
    .nav-icon-wrapper:hover .tooltip { opacity: 1; visibility: visible; }
    .tooltip {
        position: absolute;
        top: 110%;
        left: 50%;
        transform: translateX(-50%);
        background: #333;
        color: #fff;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 11px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s;
        z-index: 100;
    }

    .nav-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #f3d1dc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
      color: #5a2a55;
      overflow: hidden;
      border: 1px solid #d63384;
    }
    .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }

    header {
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(to right, #f3d1dc, #ffe0f0);
    }

    header h1 {
      font-family: "Edu AU VIC WA NT Arrows", cursive;
      font-size: 48px;
      margin: 0;
      color: #5a2a55;
    }

    header h5 {
      color: #5a2a55;
      margin-top: 20px;
      letter-spacing: 2px;
      display: inline-block;
      border: 1px solid #5a2a55;
      padding: 8px 25px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: bold;
      animation: slowFloat 3s ease-in-out infinite;
      background: rgba(255, 255, 255, 0.2);
    }

    @keyframes slowFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    .section {
      padding: 40px 20px;
    }

    .section h2 {
      font-size: 32px;
      color: #d63384;
      margin-bottom: 30px;
      text-align: center;
      font-family: 'Playfair Display', serif;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
      justify-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }

    @media (max-width: 1100px) {
      .services-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .services-grid { grid-template-columns: 1fr; }
    }

    .service-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: #ffc107;
      color: #333;
      padding: 5px 12px;
      border-radius: 50px;
      font-size: 11px;
      font-weight: bold;
      text-transform: uppercase;
      z-index: 2;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .service-box .rating {
      margin: 5px 0;
      color: #ffc107;
      font-size: 14px;
    }

    .service-box {
      background-color: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      cursor: pointer;
      width: 220px;
      text-align: center;
    }

    .service-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .service-box img {
      width: 100%;
      height: 150px;
      object-fit: cover;
    }

    .service-box h3 {
      margin: 10px;
      font-size: 18px;
      color: #333;
    }

    .service-box p {
      margin: 0 10px 15px;
      font-size: 14px;
      color: #666;
    }

    /* ✨ Hover Card Detail Overlay */
    .service-box {
      position: relative;
    }

    .service-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(214, 51, 132, 0.95);
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      opacity: 0;
      transition: opacity 0.3s ease;
      padding: 20px;
      box-sizing: border-box;
      text-align: center;
    }

    .service-box:hover .service-overlay {
      opacity: 1;
    }

    .service-overlay h4 {
      margin: 0 0 10px;
      font-size: 20px;
      font-family: 'Playfair Display', serif;
    }

    .service-overlay p {
      color: #fff !important;
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 15px;
    }

    .service-overlay .details {
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .book-btn {
      background: white;
      color: #d63384;
      border: none;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    .book-btn:hover {
      background: #f8f9fa;
      transform: scale(1.1);
    }

    /* 🎭 Heading Reveal Animation */
    .reveal-text span {
      display: inline-block;
      opacity: 0;
      transform: translateY(10px);
      animation: revealLetter 0.05s forwards;
    }

    @keyframes revealLetter {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* 📝 Questionnaire Styling */
    .questionnaire-card {
      background: white;
      border-radius: 15px;
      padding: 30px;
      margin: 40px auto;
      max-width: 800px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      border-left: 5px solid #d63384;
      text-align: left;
    }

    .questionnaire-card h4 {
      color: #5a2a55;
      margin-top: 0;
      font-family: 'Playfair Display', serif;
      font-size: 22px;
    }

    .questionnaire-card .options {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 15px;
    }

    .questionnaire-card label {
      background: #fdf2f7;
      padding: 8px 16px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 14px;
      transition: 0.3s;
      border: 1px solid transparent;
    }

    .questionnaire-card input[type="radio"] {
      display: none;
    }

    .questionnaire-card input[type="radio"]:checked + label {
      background: #d63384;
      color: white;
      border-color: #d63384;
    }

    .submit-consult {
      background: #d63384;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      margin-top: 20px;
      cursor: pointer;
      font-weight: bold;
    }

    /* 👋 Floating Waving Expert */
    .floating-expert {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      cursor: pointer;
      transition: 0.3s;
    }

    .expert-bubble {
      background: white;
      padding: 12px 18px;
      border-radius: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      margin-bottom: 10px;
      font-size: 13px;
      color: #333;
      max-width: 180px;
      border: 1px solid #d63384;
      position: relative;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none; /* Prevent interference unless hovered */
    }

    .floating-expert:hover .expert-bubble,
    .expert-bubble.show-bubble {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .expert-avatar {
      width: 70px;
      height: 70px;
      background: white;
      border-radius: 50%;
      box-shadow: 0 8px 20px rgba(214, 51, 132, 0.3);
      border: 3px solid #d63384;
      overflow: hidden;
      animation: waveExpert 2s infinite ease-in-out;
    }

    .expert-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @keyframes waveExpert {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(5deg) translateY(-5px); }
      75% { transform: rotate(-5deg); }
    }
  </style>
  <link rel="stylesheet" href="/css/responsive.css">
</head>

