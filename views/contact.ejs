  <main>
    <h1 class="reveal-text" id="contactHeading">Welcome to Kristen's Glam Hub</h1>
    <p>Your one-stop destination for all things beauty ✨</p>
  </main>
      <% const contactSuccess = locals.success_msg || ""; %>
    <% const contactError = locals.error_msg || ""; %>
    <% const successMessages = Array.isArray(contactSuccess) ? contactSuccess : (contactSuccess ? [contactSuccess] : []); %>
    <% const errorMessages = Array.isArray(contactError) ? contactError : (contactError ? [contactError] : []); %>
    <% if (successMessages.length) { %>
      <div class="alert alert-success"><%= successMessages[0] %></div>
    <% } %>
    <% if (errorMessages.length) { %>
      <div class="alert alert-error"><%= errorMessages[0] %></div>
    <% } %>
    <form class="feedback-card" action="/feedback" method="POST">
